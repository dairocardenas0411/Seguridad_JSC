<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Master.master.cs" Inherits="Seguridad_JSC.Vista.Master" %>

<!DOCTYPE html>
<html lang="es">
<head runat="server">
    <meta charset="utf-8" />
    <title>Panel - Seguridad JSC</title>
    <asp:ContentPlaceHolder ID="head" runat="server" />

    <!-- Bootstrap & FontAwesome -->
    <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />
    <link href="css/Master.css" rel="stylesheet" />

    <!-- Scripts optimizados -->
    <script src="https://code.jquery.com/jquery-3.5.1.min.js" defer></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@4.5.2/dist/js/bootstrap.bundle.min.js" defer></script>
</head>
<body>
    <form id="form1" runat="server">
        <div class="d-flex" id="wrapper">
            <!-- Sidebar -->
            <div id="sidebar-wrapper">
                <div class="sidebar-heading text-center py-4">
                    <img src="Recursos/icon1.png" alt="Seguridad JSC" class="menu-logo" />
                </div>

                <div class="list-group list-group-flush">
                    <a href="admin.aspx" class="list-group-item"><i class="fas fa-home mr-2"></i>Inicio</a>

                    <!-- menú Categorías -->
                    <div id="menuCategorias">
                        <a href="Categoria.aspx" class="list-group-item d-flex justify-content-between align-items-center">
                            <span><i class="fas fa-tags mr-2"></i>Categorías</span>
                        </a>
                    </div>

                    <!-- Submenú Proveedores -->
                    <div id="menuProveedores" class="d-none">
                        <a href="#submenuProveedores" data-toggle="collapse" class="list-group-item d-flex justify-content-between align-items-center">
                            <span><i class="fas fa-user-tie mr-2"></i>Proveedores</span>
                            <i class="fas fa-chevron-down"></i>
                        </a>
                        <div class="collapse ml-3" id="submenuProveedores">
                            <a href="RegistroProveedor.aspx" class="list-group-item list-group-item-action">
                                <i class="fas fa-user-plus mr-2"></i>Nuevo Proveedor
                            </a>
                            <a href="ListaProveedores.aspx" class="list-group-item list-group-item-action">
                                <i class="fas fa-list-alt mr-2"></i>Lista Proveedores
                            </a>
                        </div>
                    </div>


                    <!-- Submenú Productos -->
                    <div id="menuProductos" class="d-none">
                        <a href="#submenuProductos" data-toggle="collapse" class="list-group-item d-flex justify-content-between align-items-center">
                            <span><i class="fas fa-camera mr-2"></i>Productos</span>
                            <i class="fas fa-chevron-down"></i>
                        </a>
                        <div class="collapse ml-3" id="submenuProductos">
                            <a href="ListaCotizaciones.aspx" class="list-group-item list-group-item-action">
                                <i class="fas fa-plus-circle mr-2"></i>Nuevo Producto
                            </a>
                            <a href="RegistroTrabajo.aspx" class="list-group-item list-group-item-action">
                                <i class="fas fa-boxes mr-2"></i>Productos
                            </a>
                        </div>
                    </div>

                    <!-- Submenú Empleados -->
                    <div id="menuEmpleados" class="d-none">
                        <a href="#submenuEmpleados" data-toggle="collapse" class="list-group-item d-flex justify-content-between align-items-center">
                            <span><i class="fas fa-users-cog mr-2"></i>Empleados</span>
                            <i class="fas fa-chevron-down"></i>
                        </a>
                        <div class="collapse ml-3" id="submenuEmpleados">
                            <a href="RegistroUsuario.aspx" class="list-group-item list-group-item-action">
                                <i class="fas fa-user-plus mr-2"></i>Nuevo Empleado
                            </a>
                            <a href="ListaTecnicos.aspx" class="list-group-item list-group-item-action">
                                <i class="fas fa-user-friends mr-2"></i>Empleados
                            </a>
                        </div>
                    </div>

                    <!-- Submenú Trabajo -->
                    <div id="menuCotizacionesContainer" class="d-none">
                        <a href="#submenuCotizaciones" data-toggle="collapse" class="list-group-item d-flex justify-content-between align-items-center">
                            <span><i class="fas fa-chart-line mr-2"></i>Trabajo</span>
                            <i class="fas fa-chevron-down"></i>
                        </a>
                        <div class="collapse ml-3" id="submenuCotizaciones">
                            <a href="ListaCotizaciones.aspx" class="list-group-item list-group-item-action">
                                <i class="fas fa-tasks mr-2"></i>Trabajo Pendiente
                            </a>
                            <a href="TrabajoAceptado.aspx" class="list-group-item list-group-item-action">
                                <i class="fas fa-tasks mr-2"></i>Trabajo en Progreso
                            </a>
                            <a href="RegistroTrabajo.aspx" class="list-group-item list-group-item-action">
                                <i class="fas fa-plus-circle mr-2"></i>Nuevo Trabajo
                            </a>
                            <a href="HistorialCotizaciones.aspx" class="list-group-item list-group-item-action">
                                <i class="fas fa-history mr-2"></i>Historial
                            </a>
                        </div>
                    </div>


                    <a id="menuInstalaciones" href="TrabajoAsignado.aspx" class="list-group-item d-none"><i class="fas fa-tools mr-2"></i>Instalaciones</a>
                    <a id="menuPedidos" href="pedidos.aspx" class="list-group-item d-none"><i class="fas fa-shopping-cart mr-2"></i>Pedidos</a>
                </div>
            </div>

            <!-- Contenido principal -->
            <div id="page-content-wrapper">
                <nav class="navbar navbar-expand-lg">
                    <button id="menu-toggle"><i class="fas fa-bars"></i></button>

                    <div class="ml-auto d-flex align-items-center">
                        <span class="navbar-text mr-3 text-white">
                            <asp:Label ID="LblidUsuario" runat="server" Text="Invitado" Visible="false"></asp:Label>
                            <asp:Label ID="lblnombresApellidos" Style="color: white" runat="server" Text="Invitado"></asp:Label>
                        </span>



                        <div class="header-right">


                            <div class="user-dropdown-container">
                                <button class="user-dropdown-trigger" id="userDropdown" data-toggle="dropdown"
                                    aria-haspopup="true" aria-expanded="false" aria-label="Menú de usuario">
                                    <asp:Image ID="imgUsuario" runat="server" CssClass="user-avatar" Width="45" AlternateText="Avatar del usuario" />
                                    <div class="user-status-indicator"></div>
                                </button>

                                <div class="user-dropdown-menu dropdown-menu dropdown-menu-right" aria-labelledby="userDropdown">
                                    <div class="dropdown-header">
                                        <div class="user-info-dropdown">
                                            <asp:Image ID="imgUsuarioDropdown" runat="server" CssClass="user-avatar-small" Width="32" AlternateText="Avatar del usuario" />
                                            <div class="user-details">
                                                <asp:Label ID="lblNombreDropdown" runat="server" Text="Usuario" CssClass="user-name-dropdown" />
                                                <asp:Label ID="lblRol" runat="server" Text="Usuario" class="user-role" />
                                            </div>
                                        </div>
                                    </div>

                                    <div class="dropdown-divider"></div>

                                    <asp:LinkButton ID="btnPerfil" runat="server" CssClass="dropdown-item dropdown-action"
                                        OnCommand="btnPerfil_Command">
                                          <i class='fas fa-user-edit'></i> Editar Perfil
                                    </asp:LinkButton>

                                    <asp:Button ID="btncerrarSession" runat="server" CssClass="dropdown-item dropdown-action logout"
                                        OnClick="btncerrarSession_Click" CausesValidation="false" Text="Cerrar Sesión" />
                                </div>
                            </div>
                        </div>


                    </div>
                </nav>

                <div class="container-fluid mt-3">
                    <asp:ContentPlaceHolder ID="MainContent" runat="server" />
                </div>
            </div>
        </div>
    </form>

    <script>
        document.addEventListener("DOMContentLoaded", () => {
            const userRole = '<%= Session["idRol"] %>';

            const rolePermissions = {
                "1": ["menuCategorias", "menuProductos", "menuEmpleados", "menuCotizacionesContainer", "menuProveedores"],
                "2": ["menuInstalaciones"],
                "3": ["menuPedidos"]
            };

            if (rolePermissions[userRole]) {
                rolePermissions[userRole].forEach(id => document.getElementById(id).classList.remove("d-none"));
            } else {
                window.location.href = "../index.aspx";
            }

            document.getElementById("menu-toggle").addEventListener("click", (e) => {
                e.preventDefault();
                document.getElementById("wrapper").classList.toggle("toggled");
            });
        });
    </script>
</body>
</html>
